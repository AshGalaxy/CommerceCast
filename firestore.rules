/**
 * @fileoverview Firestore Security Rules for Google Sheet Sync Configurations.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for Google Sheet sync configurations.
 * Only the authenticated user who owns a configuration can read, create, update, or delete it.
 *
 * Data Structure:
 * All Google Sheet sync configurations are nested under the `/users/{userId}/googleSheetSyncs/{googleSheetSyncId}` path.
 * The `userId` path segment must match the `userId` field within the `GoogleSheetSync` document.
 *
 * Key Security Decisions:
 * - User listing is disallowed for privacy.
 * - All write operations are protected by an ownership check.
 * - Flexible data validation is used to allow for rapid iteration.
 *
 * Denormalization for Authorization:
 * The `GoogleSheetSync` document contains a `userId` field that is used to authorize access.
 * This denormalization avoids the need for costly `get()` calls to a separate user document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects Google Sheet sync configurations for individual users.
     * @path /users/{userId}/googleSheetSyncs/{googleSheetSyncId}
     * @allow (create) - User 'user123' can create a new config under their own user ID.
     *    Request: { auth: { uid: 'user123' }, resource: { data: { userId: 'user123', sheetId: 'sheet456', sheetName: 'Sheet1', syncInterval: 60, dataMapping: '{}', id: 'config789' } } }
     * @allow (get, update, delete) - User 'user123' can access their own config.
     *    Request: { auth: { uid: 'user123' }, resource: { data: { userId: 'user123', sheetId: 'sheet456', sheetName: 'Sheet1', syncInterval: 60, dataMapping: '{}', id: 'config789' } } }
     * @deny (create) - User 'user123' cannot create a config under another user's ID.
     *    Request: { auth: { uid: 'user123' }, resource: { data: { userId: 'user456', sheetId: 'sheet456', sheetName: 'Sheet1', syncInterval: 60, dataMapping: '{}', id: 'config789' } } }
     * @deny (get, update, delete) - User 'user123' cannot access another user's config.
     *    Request: { auth: { uid: 'user123' }, resource: { data: { userId: 'user456', sheetId: 'sheet456', sheetName: 'Sheet1', syncInterval: 60, dataMapping: '{}', id: 'config789' } } }
     * @principle Enforces document ownership and relational integrity.
     */
    match /users/{userId}/googleSheetSyncs/{googleSheetSyncId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the authenticated user is the owner of the document
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Helper function to check if the authenticated user is the owner of the existing document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Read rules: get
      allow get: if isOwner(userId);

      // Read rules: list
      allow list: if isOwner(userId);

      // Write rules: create
      allow create: if isOwner(userId) && request.resource.data.userId == userId && request.resource.data.id == googleSheetSyncId;

      // Write rules: update
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;

      // Write rules: delete
      allow delete: if isExistingOwner(userId);
    }
  }
}